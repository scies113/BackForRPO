# ============================================================================
#  GoBackendFootball — .gitignore
#  Версия: 4.0.0 | Дата: 28 апреля 2026 г.
# ============================================================================

# ──────────────────────────────────────────────
#  Скомпилированные бинарники Go
# ──────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
tmp/
main

# ──────────────────────────────────────────────
#  Конфигурация и секреты
# ──────────────────────────────────────────────
.env
.env.local
.env.production
*.pem
*.key

# ──────────────────────────────────────────────
#  Cookies / токены (чувствительные данные)
# ──────────────────────────────────────────────
cookies.txt
*.cookie
*.cookies

# ──────────────────────────────────────────────
#  Зависимости Go
# ──────────────────────────────────────────────
vendor/

# ──────────────────────────────────────────────
#  Тестирование и покрытие
# ──────────────────────────────────────────────
*.test
*.out
coverage.html
coverage.txt
*.prof

# ──────────────────────────────────────────────
#  IDE и редакторы
# ──────────────────────────────────────────────

# VS Code
.vscode/

# JetBrains (GoLand, IntelliJ)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~

# Gemini / AI tools
.gemini/

# ──────────────────────────────────────────────
#  ОС — системные файлы
# ──────────────────────────────────────────────

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*.orig

# ──────────────────────────────────────────────
#  Docker
# ──────────────────────────────────────────────
docker-compose.override.yml

# ──────────────────────────────────────────────
#  Логи
# ──────────────────────────────────────────────
*.log
logs/

# ──────────────────────────────────────────────
#  Прочее
# ──────────────────────────────────────────────
*.bak
*.tmp
*.cache

# ──────────────────────────────────────────────
#  Python (для ML-сервиса)
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Виртуальные окружения
venv/
.env/
.venv/
env.bak/
venv.bak/

# Но мы ДОЛЖНЫ оставить модели и датасет (иначе Dockerfile ML сломается)
!ml_model/*.csv
!ml_model/*.pkl
!ml_model/*.json
